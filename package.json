{
  "name": "should-release",
  "version": "1.2.0",
  "description": "Minimalistic command line tool to check if a new release should to be published",
  "type": "module",
  "bin": "cli.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "should-release": "node ./cli.js",
    "release": "standard-version"
  },
  "keywords": [
    "semver",
    "release",
    "version",
    "versioning"
  ],
  "main": "index.js",
  "repository": "saintedlama/should-release",
  "author": "Christoph Walcher <christoph.walcher@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "conventional-recommended-bump": "^12.1.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0"
  }
}
